{
  "name": "@interco/inter-toranja",
  "author": "Core - Squad Frontend: Marlon Castro <marlon.castro@inter.co>, Luana Pina Pavanelli <luana.guimaraes@inter.co>; former devs: Diego Santos <disantos@inter.co>, Kaê Uchôa <kae.sarmanho@inter.co>",
  "version": "2.0.1",
  "type": "module",
  "license": "MIT",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "repository": "git@gitlabssh.sharedservices.local:frontend/inter-frontend-toranja.git",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build-storybook": "storybook build --output-dir public --loglevel verbos && node scripts/assert-storybook-manager.mjs",
    "build:tokens_transformed_json": "node ./scripts/tokens_transformed_json.cjs",
    "build:tokens": "yarn run build:tokens_transformed_json && yarn run build:tokensMode && yarn run build:tokensTypography && yarn run build:tokensTheme && yarn run build:tokensGlobal && yarn run build:tokensStyles && yarn run build:tokensBreakpoint && yarn run clean:tokens_transformed",
    "build:tokensBreakpoint": "node ./scripts/styleDictionaryBreakpoint.tokens.config.mjs ",
    "build:tokensGlobal": "node ./scripts/styleDictionaryGlobal.config.mjs",
    "build:tokensMode": "node ./scripts/styleDictionaryMode.config.mjs",
    "build:tokensStyles": "node ./scripts/styleDictionaryStyles.config.mjs",
    "build:tokensTheme": "node ./scripts/styleDictionaryThemePF.config.mjs && node ./scripts/styleDictionaryThemePJ.config.mjs",
    "build:tokensTypography": "node ./scripts/styleDictionaryTypography.tokens.config.mjs",
    "build:skills": "node ./scripts/generate-skills.mjs",
    "generate:icon-names": "node ./scripts/generate-icon-names.mjs",
    "check:icon-names": "node ./scripts/generate-icon-names.mjs --check",
    "build": "tsc --p ./tsconfig-build.json && vite build && yarn run build:skills",
    "typecheck": "tsc --p ./tsconfig-build.json",
    "clean:tokens_transformed": "rm -rf tokens_transformed",
    "dev": "storybook dev -p 6006",
    "docs:landing": "node docs/desktop/roadmap-landing/serve-landing.mjs",
    "lint": "eslint .",
    "postbuild": "rm -rf lib && mkdir lib && cp -R dist/assets/. lib/",
    "postinstall": "node dist/copy-skills.mjs --check-env || exit 0",
    "postpublish": "./scripts/postpublish.sh",
    "preview": "vite preview",
    "start": "vite",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:related": "vitest related --run --passWithNoTests",
    "test:snapshot-update": "vitest run -u",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,scss,css,json,md,mdx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,scss,css,json,md,mdx}\"",
    "prepare": "husky",
    "toranja:copy-skills": "node dist/copy-skills.mjs",
    "yalc": "yarn build && yalc publish --push"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "peerDependencies": {
    "@types/glob": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --max-warnings=0",
    "{src,scripts}/**/*.{js,jsx,ts,tsx,mjs,cjs}": "yarn test:related"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.16.0",
    "@interco/eslint-config-inter-frontend": "^4.0.4",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-actions": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.6",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-viewport": "^8.6.14",
    "@storybook/blocks": "^8.4.6",
    "@storybook/components": "^8.4.7",
    "@storybook/manager-api": "^8.4.7",
    "@storybook/react": "^8.4.6",
    "@storybook/react-vite": "^8.4.6",
    "@storybook/test": "^8.4.6",
    "@storybook/theming": "^8.4.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-storybook": "^0.11.1",
    "glob": "^11.1.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.5",
    "postcss": "^8.5.18",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass-embedded": "^1.82.0",
    "storybook": "^8.4.6",
    "storybook-addon-tag-badges": "1.3.2",
    "style-dictionary": "^3.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "uuid": "^11.0.4",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-lib-inject-css": "^2.1.1",
    "vitest": "^3.2.6"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.26.10",
    "@interco/icons": "^7.0.0",
    "framer-motion": "^11.14.4"
  },
  "bin": {
    "toranja-copy-skills": "dist/copy-skills.mjs"
  },
  "resolutions": {
    "glob": "^11.1.0",
    "vite": "^6.4.3",
    "postcss": "^8.5.18",
    "nanoid": "^3.3.18",
    "rollup": "^4.59.0",
    "fast-uri": "^3.1.8",
    "flatted": "^3.4.2",
    "form-data": "^4.0.6",
    "lodash": "^4.17.23",
    "yaml": "^2.8.3",
    "tmp": "^0.2.6",
    "@humanfs/node": "^0.16.8",
    "@babel/runtime": "^7.26.10",
    "@eslint/plugin-kit": "^0.3.4",
    "prismjs": "^1.30.0",
    "eslint-plugin-import": "^2.31.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}

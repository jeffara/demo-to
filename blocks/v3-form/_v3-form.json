{
  "definitions": [
    {
      "title": "Item — v3-form",
      "id": "v3-form-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Item",
              "model": "v3-form-item",
              "kind": "text",
              "required": false
            }
          }
        }
      }
    },
    {
      "title": "Formulário configurável",
      "id": "v3-form",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "v3-form",
              "model": "v3-form",
              "filter": "v3-form",
              "title": "Fale com um Especialista do Inter",
              "titleType": "h2",
              "subtitle": "Preencha seus dados para receber uma consultoria exclusiva sobre contas, investimentos ou crédito.",
              "submitLabel": "Enviar Solicitação",
              "successMessage": "Solicitação recebida com sucesso! Entraremos em contato em breve."
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "v3-form",
      "fields": [
        {
          "component": "text",
          "name": "title",
          "label": "Título do Formulário",
          "value": "Fale com um Especialista do Inter",
          "valueType": "string"
        },
        {
          "component": "select",
          "name": "titleType",
          "label": "Nível do título",
          "valueType": "string",
          "value": "h2",
          "options": [
            {
              "name": "H1",
              "value": "h1"
            },
            {
              "name": "H2",
              "value": "h2"
            },
            {
              "name": "H3",
              "value": "h3"
            },
            {
              "name": "H4",
              "value": "h4"
            },
            {
              "name": "H5",
              "value": "h5"
            },
            {
              "name": "H6",
              "value": "h6"
            }
          ]
        },
        {
          "component": "text",
          "name": "subtitle",
          "label": "Subtítulo / Instrução",
          "value": "Preencha seus dados para receber uma consultoria exclusiva sobre contas, investimentos ou crédito.",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "submitLabel",
          "label": "Texto do Botão de Envio",
          "value": "Enviar Solicitação",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "successMessage",
          "label": "Mensagem de Sucesso",
          "value": "Solicitação recebida com sucesso! Entraremos em contato em breve.",
          "valueType": "string"
        },
        {
          "component": "richtext",
          "name": "consent",
          "label": "Texto e link de consentimento",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "integrationId",
          "label": "Integração cadastrada",
          "valueType": "string",
          "description": "Identificador definido pelo time técnico; exemplo inter-lead. Sem integração cadastrada, o v3-formulário não envia dados."
        },
        {
          "component": "text",
          "name": "formId",
          "label": "Identificador do v3-formulário",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "failureMessage",
          "label": "Mensagem de falha",
          "valueType": "string"
        }
      ]
    },
    {
      "id": "v3-form-item",
      "fields": [
        {
          "component": "text",
          "name": "fieldName",
          "label": "Nome técnico",
          "valueType": "string",
          "required": true,
          "validation": {
            "regExp": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          }
        },
        {
          "component": "text",
          "name": "label",
          "label": "Rótulo",
          "valueType": "string",
          "required": true
        },
        {
          "component": "select",
          "name": "kind",
          "label": "Tipo",
          "valueType": "string",
          "value": "text",
          "options": [
            {
              "name": "text",
              "value": "text"
            },
            {
              "name": "email",
              "value": "email"
            },
            {
              "name": "tel",
              "value": "tel"
            },
            {
              "name": "cpf",
              "value": "cpf"
            },
            {
              "name": "textarea",
              "value": "textarea"
            },
            {
              "name": "select",
              "value": "select"
            },
            {
              "name": "checkbox",
              "value": "checkbox"
            },
            {
              "name": "switch",
              "value": "switch"
            },
            {
              "name": "radio",
              "value": "radio"
            },
            {
              "name": "stepper",
              "value": "stepper"
            },
            {
              "name": "money",
              "value": "money"
            },
            {
              "name": "number",
              "value": "number"
            },
            {
              "name": "date",
              "value": "date"
            },
            {
              "name": "password",
              "value": "password"
            }
          ]
        },
        {
          "component": "text",
          "name": "placeholder",
          "label": "Placeholder",
          "valueType": "string"
        },
        {
          "component": "boolean",
          "name": "required",
          "label": "Obrigatório",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "richtext",
          "name": "options",
          "label": "Opções: lista de valores",
          "valueType": "string",
          "description": "Lista: um item por opção. Use Rótulo | valor quando forem diferentes.",
          "condition": {
            "in": [
              {
                "var": "kind"
              },
              [
                "select",
                "radio"
              ]
            ]
          }
        },
        {
          "name": "defaultValue",
          "label": "Valor inicial",
          "component": "text",
          "valueType": "string"
        },
        {
          "name": "hint",
          "label": "Ajuda",
          "component": "text",
          "valueType": "string"
        },
        {
          "name": "errorMessage",
          "label": "Mensagem de validação",
          "component": "text",
          "valueType": "string"
        },
        {
          "name": "min",
          "label": "Mínimo",
          "component": "number",
          "valueType": "number"
        },
        {
          "name": "max",
          "label": "Máximo",
          "component": "number",
          "valueType": "number"
        },
        {
          "name": "step",
          "label": "Incremento",
          "component": "number",
          "valueType": "number"
        },
        {
          "name": "minLength",
          "label": "Mínimo de caracteres",
          "component": "number",
          "valueType": "number"
        },
        {
          "name": "maxLength",
          "label": "Máximo de caracteres",
          "component": "number",
          "valueType": "number"
        },
        {
          "name": "pattern",
          "label": "Formato (expressão regular)",
          "component": "text",
          "valueType": "string"
        },
        {
          "name": "disabled",
          "label": "Desabilitado",
          "component": "boolean",
          "valueType": "boolean"
        },
        {
          "name": "readOnly",
          "label": "Somente leitura",
          "component": "boolean",
          "valueType": "boolean"
        },
        {
          "name": "showWhenField",
          "label": "Mostrar quando este campo",
          "component": "text",
          "valueType": "string"
        },
        {
          "name": "showWhenValue",
          "label": "Tiver este valor",
          "component": "text",
          "valueType": "string",
          "condition": {
            "!!": {
              "var": "showWhenField"
            }
          }
        },
        {
          "name": "showWhenOperator",
          "label": "Condição",
          "component": "select",
          "valueType": "string",
          "options": [
            {
              "name": "Igual a",
              "value": "equals"
            },
            {
              "name": "Diferente de",
              "value": "notEquals"
            }
          ],
          "condition": {
            "!!": {
              "var": "showWhenField"
            }
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "v3-form",
      "components": [
        "v3-form-item"
      ]
    }
  ]
}